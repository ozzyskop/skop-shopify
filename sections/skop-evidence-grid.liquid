<section class="skop-evidence skop-section">
  <div class="page-width">
    <div class="skop-evidence__intro">
      <p class="skop-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rte">{{ section.settings.body }}</div>
    </div>

    <div class="skop-evidence__grid">
      {%- for block in section.blocks -%}
        <article class="skop-evidence__card" {{ block.shopify_attributes }}>
          <span>{{ block.settings.index | escape }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
          <strong>{{ block.settings.status | escape }}</strong>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .skop-evidence {
    background: var(--skop-graphite);
    color: var(--skop-white);
  }

  .skop-evidence h2,
  .skop-evidence h3 {
    color: inherit;
  }

  .skop-evidence__intro {
    max-width: 78rem;
  }

  .skop-evidence__intro h2 {
    font-size: clamp(4rem, 7vw, 8rem);
    letter-spacing: -0.06em;
    line-height: 0.95;
    margin: 1.5rem 0 2.5rem;
  }

  .skop-evidence__intro .rte {
    color: rgb(255 255 255 / 65%);
    font-size: 1.8rem;
  }

  .skop-evidence__grid {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 6rem;
  }

  .skop-evidence__card {
    border: 1px solid rgb(255 255 255 / 14%);
    min-height: 30rem;
    padding: 3rem;
  }

  .skop-evidence__card > span {
    color: var(--skop-mint);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .skop-evidence__card h3 {
    font-size: 2.6rem;
    margin: 7rem 0 1.5rem;
  }

  .skop-evidence__card p {
    color: rgb(255 255 255 / 62%);
  }

  .skop-evidence__card strong {
    color: var(--skop-mint);
    display: block;
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    margin-top: 3rem;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .skop-evidence__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SKOP evidence grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Evidence before claims"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A proof system, not a promise wall."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Lab, safety, athlete, and demonstration records will appear only after their source and permissions are approved.</p>"
    }
  ],
  "blocks": [
    {
      "type": "evidence",
      "name": "Evidence type",
      "settings": [
        {
          "type": "text",
          "id": "index",
          "label": "Index",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Laboratory results"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Structured comparative results tied to a named formulation and method."
        },
        {
          "type": "text",
          "id": "status",
          "label": "Status",
          "default": "Pending validation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SKOP evidence grid",
      "blocks": [{ "type": "evidence" }, { "type": "evidence" }, { "type": "evidence" }]
    }
  ]
}
{% endschema %}
